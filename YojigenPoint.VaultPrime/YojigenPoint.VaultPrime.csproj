<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Yojigen Point Core Utilities</Title>
    <Description>A lightweight, modern, and secure core utility library for .NET. Provides a poweful set of high-performance helpers and extensions for strings, dates, URIs, and security primitives like GUID and password generator. Build with zero external dependencies.</Description>
    <Copyright>Copyright (c) Yojigen Point 2025</Copyright>
    <PackageProjectUrl>https:/github.com/yojigenpoint/yojigenpoint.vaultprime</PackageProjectUrl>
    <PackageIcon>yp_logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/yojigenpoint/yojigenpoint.vaultprime.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>extensions helpers utility core security guid password dotnet csharp</PackageTags>
    <PackageReleaseNotes>Add support .NET 10.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="C:\Users\Yojigen\Downloads\yp_logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
